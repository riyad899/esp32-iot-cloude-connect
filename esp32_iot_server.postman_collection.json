{
  "info": {
    "_postman_id": "a5e8f49a-7c21-4f11-9a45-66778899aabb",
    "name": "ESP32 IoT Cloud Connect API (Open - No Auth Required)",
    "description": "Open Postman collection for ESP32 IoT Server (No auth headers required). You can test immediately by clicking Send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://esp32-iot-cloude-connect.vercel.app",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "esp32-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET Poll Relay Commands (Open)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/device/relay/command?deviceId={{deviceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "device", "relay", "command"],
          "query": [
            {
              "key": "deviceId",
              "value": "{{deviceId}}"
            }
          ]
        }
      }
    },
    {
      "name": "2. POST Set Both Relays ON (Open)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"relay1\": \"ON\",\n  \"relay2\": \"ON\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/device/relay",
          "host": ["{{baseUrl}}"],
          "path": ["api", "device", "relay"]
        }
      }
    },
    {
      "name": "3. POST Set Relay 1 ON Only",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"relay1\": \"ON\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/device/relay",
          "host": ["{{baseUrl}}"],
          "path": ["api", "device", "relay"]
        }
      }
    },
    {
      "name": "4. POST Set Relay 2 ON Only",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"relay2\": \"ON\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/device/relay",
          "host": ["{{baseUrl}}"],
          "path": ["api", "device", "relay"]
        }
      }
    },
    {
      "name": "5. POST Set Both Relays OFF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"relay1\": \"OFF\",\n  \"relay2\": \"OFF\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/device/relay",
          "host": ["{{baseUrl}}"],
          "path": ["api", "device", "relay"]
        }
      }
    },
    {
      "name": "6. GET Latest Sensor Reading",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/device/data/latest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "device", "data", "latest"]
        }
      }
    },
    {
      "name": "7. GET Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    }
  ]
}
